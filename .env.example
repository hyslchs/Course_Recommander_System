# Compound deterministic query analysis is intentionally disabled by default.
FJU_COMPOUND_QUERY_ENABLED=0
FJU_RECOMMENDER_ARTIFACTS_DIR=data/artifacts/1151
FJU_VERIFY_ARTIFACT_HASHES=1
OPENAI_API_KEY=
FJU_AI_MODEL=gpt-5.6-luna
FJU_AI_REASONING_EFFORT=none
FJU_AI_MAX_OUTPUT_TOKENS=1000
FJU_AI_MAX_QUESTION_CHARS=500
FJU_AI_MONTHLY_REQUEST_LIMIT=10000
FJU_AI_REQUESTS_PER_MINUTE=10
FJU_AI_TIMEOUT_SECONDS=25
FJU_AI_MODERATION_ENABLED=1
FJU_AI_USAGE_DB=data/runtime/ai-usage.sqlite3

# Privacy-first analytics. Set FJU_ANALYTICS_ENABLED=0 to switch collection off
# entirely (the ingest endpoint then accepts and discards, so the frontend keeps
# working unchanged). Retention is enforced on boot and during traffic.
FJU_ANALYTICS_ENABLED=1
FJU_ANALYTICS_DB=data/runtime/analytics.sqlite3
FJU_ANALYTICS_EVENT_RETENTION_DAYS=180
FJU_ANALYTICS_DIAGNOSTIC_RETENTION_DAYS=90
# After this many days session_id and interaction_id are nulled out of raw rows,
# so nothing older can be joined into a per-student history.
FJU_ANALYTICS_ID_RETENTION_DAYS=7
FJU_ANALYTICS_REQUESTS_PER_MINUTE=60
# Required to read /api/v1/analytics/report and the dashboard. Unset = the
# report is unavailable; it never defaults to open.
FJU_ANALYTICS_ADMIN_TOKEN=
