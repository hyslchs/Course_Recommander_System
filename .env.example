# CPU-only EmbeddingGemma runtime (the model is baked into the image).
FJU_EMBEDDING_DEVICE=cpu
FJU_EMBEDDING_THREADS=8
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
# Build-only input; set in the shell, never store secrets here.
# CRS_ARTIFACT_BUNDLE_DIR=/var/lib/crs/artifact-bundles/<immutable-bundle-id>
FJU_RECOMMENDER_ARTIFACTS_DIR=/app/data/artifacts/1151-embeddinggemma-768
FJU_RECOMMENDER_CANONICAL_JSONL=/app/data/canonical/course_outlines_1151.jsonl
FJU_VERIFY_ARTIFACT_HASHES=1
FJU_COMPOUND_QUERY_ENABLED=0

# Runtime hardening. API docs are off unless explicitly enabled for development.
FJU_ENV=production
FJU_ENABLE_API_DOCS=0
# Production fixed-network example (current CRS topology):
# network: crs-production-network
# subnet: 172.24.0.0/24
# gateway/socket peer: 172.24.0.1
# Use the narrow, verified proxy-peer CIDR for the actual deployment. Other
# topologies must not copy this value; X-Forwarded-For is never trusted.
FJU_TRUSTED_PROXY_IPS=

# AI assistant. Leave empty to keep the feature disabled; never commit a value.
OPENAI_API_KEY=
FJU_AI_MODEL=gpt-5.6-luna
FJU_AI_REASONING_EFFORT=none
FJU_AI_MAX_OUTPUT_TOKENS=1000
FJU_AI_MAX_QUESTION_CHARS=500
FJU_AI_MONTHLY_REQUEST_LIMIT=10000
FJU_AI_REQUESTS_PER_MINUTE=10
FJU_AI_TIMEOUT_SECONDS=25
FJU_AI_MODERATION_ENABLED=1
FJU_AI_USAGE_DB=/app/data/runtime/ai-usage.sqlite3

# Analytics is disabled until an explicit retention/token policy is configured.
FJU_ANALYTICS_ENABLED=0
FJU_ANALYTICS_INSTRUMENTATION_V3=0
FJU_SERVER_BUILD_SHA=unknown
FJU_ANALYTICS_DB=/app/data/runtime/analytics.sqlite3
FJU_ANALYTICS_EVENT_RETENTION_DAYS=180
FJU_ANALYTICS_DIAGNOSTIC_RETENTION_DAYS=90
FJU_ANALYTICS_ID_RETENTION_DAYS=7
FJU_ANALYTICS_REQUESTS_PER_MINUTE=60
FJU_ANALYTICS_ADMIN_REQUESTS_PER_MINUTE=5
FJU_ANALYTICS_MAX_ROWS=250000
FJU_ANALYTICS_MAX_DB_BYTES=67108864
FJU_ANALYTICS_ADMIN_TOKEN=
