frontend/dist/
# Generated by frontend/scripts/build-fonts.py (the `prebuild` script) from the
# @fontsource/noto-sans-tc dependency. 7.7 MB of woff2 that must not enter git;
# the inputs (scripts/font-tiers/*.txt) are committed instead.
frontend/src/assets/fonts/
frontend/*.tsbuildinfo
# tsc -b emit artifacts of vite.config.ts — must never be committed:
# Vite resolves vite.config.js before vite.config.ts, so a stale .js silently
# shadows the real config.
frontend/vite.config.js
frontend/vite.config.d.ts

data/raw/
data/canonical/
data/derived/
data/artifacts/
new-vector-data/
artifact-bundles/
logs/
data/runtime/

